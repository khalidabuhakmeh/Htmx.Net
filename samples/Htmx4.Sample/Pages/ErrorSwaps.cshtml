@page
@model Htmx4.Sample.Pages.ErrorSwapsModel
@{
    ViewData["Title"] = "ErrorSwaps";

    var markup = @"<button hx-get=""/demo/status/422"" hx-target=""#err-422"">422 (swaps)</button>

<form hx-post=""/ErrorSwaps?handler=Validate"" hx-target=""#err-form-out"">
    <input name=""item"" value=""42"" />
    <button hx-delete=""/ErrorSwaps?handler=Delete""
            hx-include=""closest form"" hx-target=""#del-out"">DELETE</button>
</form>";

    var server = @"// DemoController.cs
[HttpGet(""status/{code:int}"")]
public IActionResult Status(int code) => code switch
{
    422 => Frag(""<div class='error'>Validation failed</div>"", 422),
    500 => Frag(""<div class='error'>Server exploded</div>"", 500),
    204 => NoContent(),        // htmx: no swap
    304 => StatusCode(304),    // htmx: no swap
    _   => NotFound()
};

// Frag(html, status) is this sample's shortcut for an HTML fragment.
// A real app returns Partial(""_View"", model) or Content(html, ""text/html"").";
}

<h1>Error responses swap by default (htmx 4)</h1>
<p class="demo-lead">
    In htmx 4 the default <code>noSwap</code> list is <code>[204, 304]</code>. Every other status, including 4xx and 5xx,
    swaps its body into the target, so validation errors render without extra config. DELETE requests also no longer
    include form inputs unless you add <code>hx-include</code>.
</p>

<section class="how">
    <h2>How it works</h2>
    <p>
        The server returns the right status code with an HTML body. htmx decides whether to swap from the status, so
        the same fragment-returning handler serves success and error cases.
    </p>
    <div class="code-pair">
        <figure class="code">
            <figcaption><span class="file">ErrorSwaps.cshtml</span><span class="lang">html</span></figcaption>
            <pre><code>@markup</code></pre>
        </figure>
        <figure class="code">
            <figcaption><span class="file">DemoController.cs</span><span class="lang">csharp</span></figcaption>
            <pre><code>@server</code></pre>
        </figure>
    </div>
</section>

<section class="stage">
    <p class="stage__label">Try it</p>
    <div class="btn-row">
        <button data-testid="err-btn-422" hx-get="/demo/status/422" hx-target="#err-422">422 (swaps)</button>
        <button data-testid="err-btn-500" hx-get="/demo/status/500" hx-target="#err-500">500 (swaps)</button>
        <button data-testid="err-btn-204" hx-get="/demo/status/204" hx-target="#err-204">204 (no swap)</button>
        <button data-testid="err-btn-304" hx-get="/demo/status/304" hx-target="#err-304">304 (no swap)</button>
    </div>
    <p class="hint">
        Click each button: the <strong>422 and 500</strong> bodies still swap in below, while <strong>204 and 304</strong>
        leave their box reading "(untouched)".
    </p>
    <div class="result">
        <div id="err-422" data-testid="err-422">(untouched)</div>
        <div id="err-500" data-testid="err-500">(untouched)</div>
        <div id="err-204" data-testid="err-204">(untouched)</div>
        <div id="err-304" data-testid="err-304">(untouched)</div>
    </div>
    <hr />
    <h2>Validation form (422 swaps)</h2>
    <form hx-post="/ErrorSwaps?handler=Validate" hx-target="#err-form-out" data-testid="err-form" class="btn-row">
        <input name="name" data-testid="err-form-name" />
        <button type="submit" data-testid="err-form-submit">Submit</button>
    </form>
    <p class="hint">Submit with an <strong>empty name</strong> to see the 422 validation message swap in.</p>
    <div class="result" id="err-form-out" data-testid="err-form-out">(none)</div>
    <hr />
    <h2>hx-delete + hx-include</h2>
    <p>htmx 4 does not include form inputs on DELETE; add <code>hx-include="closest form"</code>.</p>
    <form data-testid="del-form" class="btn-row">
        <input name="item" value="42" data-testid="del-item" />
        <button type="button" data-testid="del-btn-plain" hx-delete="/ErrorSwaps?handler=Delete" hx-target="#del-out">DELETE (no include)</button>
        <button type="button" data-testid="del-btn-include" hx-delete="/ErrorSwaps?handler=Delete" hx-include="closest form" hx-target="#del-out">DELETE (hx-include closest form)</button>
    </form>
    <p class="hint">Compare the two buttons: only the <strong>include</strong> variant sends the item value to the server.</p>
    <div class="result" id="del-out" data-testid="del-out">(none)</div>
</section>
