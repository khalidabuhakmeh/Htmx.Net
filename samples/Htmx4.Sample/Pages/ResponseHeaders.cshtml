@page
@model Htmx4.Sample.Pages.ResponseHeadersModel
@{
    ViewData["Title"] = "ResponseHeaders";
    var swaps = new[] { "innerHTML", "outerHTML", "beforebegin", "afterbegin", "beforeend", "afterend", "delete", "none", "outerSync", "innerMorph", "outerMorph", "textContent", "before", "prepend", "append", "after" };

    var without = @"// Without htmx.NET: raw header names + hand-escaped JSON
Response.Headers[""HX-Push-Url""] = ""/ResponseHeaders?pushed=1"";
Response.Headers[""HX-Reswap""]   = ""beforeend"";
Response.Headers[""HX-Retarget""] = ""#resp-retarget-target"";
Response.Headers[""HX-Location""] =
    ""{\""path\"":\""/Location\"",\""target\"":\""#resp-result\"",\""swap\"":\""innerHTML\""}"";";

    var with = @"// With htmx.NET: typed, fluent, no magic strings
Response.Htmx(h => h
    .PushUrl(""/ResponseHeaders?pushed=1"")
    .Reswap(HtmxSwap.BeforeEnd)
    .Retarget(""#resp-retarget-target"")
    .Location(new HtmxLocation {
        Path = ""/Location"", Target = ""#resp-result"", Swap = HtmxSwap.InnerHtml }));";
}
<h1>Response headers</h1>
<p class="demo-lead">
    htmx.NET gives you a fluent <code>Response.Htmx(h =&gt; ...)</code> builder for the <code>HX-*</code>
    response headers, with typed <code>HtmxSwap</code> and <code>HtmxLocation</code> values, so you steer
    htmx from the server without hand-writing header names or escaped JSON.
</p>

<section class="how">
    <h2>How it works</h2>
    <p>
        The button markup is plain htmx (<code>hx-get</code> + <code>hx-target</code>); the difference is
        on the server. Both columns set the same <code>HX-*</code> headers.
    </p>
    <div class="code-pair">
        <figure class="code code--without">
            <figcaption><span class="file">Without htmx.NET</span><span class="lang">csharp</span></figcaption>
            <pre><code>@without</code></pre>
        </figure>
        <figure class="code code--with">
            <figcaption><span class="file">With htmx.NET</span><span class="lang">csharp</span></figcaption>
            <pre><code>@with</code></pre>
        </figure>
    </div>
</section>

<section class="stage">
    <p class="stage__label">Try it</p>
    <div class="btn-row">
        <button data-testid="resp-btn-push-url" hx-get="/demo/resp/push-url" hx-target="#resp-result">PushUrl</button>
        <button data-testid="resp-btn-prevent-push" hx-get="/demo/resp/prevent-push" hx-target="#resp-result" hx-push-url="true">PreventPush (hx-push-url=true, server vetoes)</button>
        <button data-testid="resp-btn-replace-url" hx-get="/demo/resp/replace-url" hx-target="#resp-result">ReplaceUrl</button>
        <button data-testid="resp-btn-prevent-replace" hx-get="/demo/resp/prevent-replace" hx-target="#resp-result" hx-replace-url="true">PreventReplace (hx-replace-url=true, server vetoes)</button>
        <button data-testid="resp-btn-redirect" hx-get="/demo/resp/redirect" hx-target="#resp-result">Redirect (full navigation to /Boosted)</button>
        <button data-testid="resp-btn-refresh" hx-get="/demo/resp/refresh" hx-target="#resp-result">Refresh</button>
        <button data-testid="resp-btn-retarget" hx-get="/demo/resp/retarget" hx-target="#resp-result">Retarget (to #resp-retarget-target)</button>
        <button data-testid="resp-btn-reswap" hx-get="/demo/resp/reswap" hx-target="#resp-result">Reswap (beforeend)</button>
        <button data-testid="resp-btn-reselect" hx-get="/demo/resp/reselect" hx-target="#resp-result">Reselect (#resp-pick)</button>
        <button data-testid="resp-btn-location-string" hx-get="/demo/resp/location-string" hx-target="#resp-result">Location (string)</button>
        <button data-testid="resp-btn-location-object" hx-get="/demo/resp/location-object" hx-target="#resp-result">Location (HtmxLocation object)</button>
    </div>
    <p class="hint">
        Watch the <strong>URL bar</strong> and the query string shown below for the push and replace buttons, the
        <strong>Result</strong> well for swap and select changes, and the <strong>retarget</strong> box for content that lands
        somewhere other than the declared target. Redirect and Refresh reload the page.
    </p>
    <p>Current URL query: <code data-testid="resp-query">@Request.QueryString.Value</code></p>
    <div class="result" id="resp-result" data-testid="resp-result-box">(no result yet)</div>
    <div id="resp-retarget-target" data-testid="resp-retarget-target">(retarget target)</div>

    <h2>HtmxSwap matrix (Reswap with every constant)</h2>
    <div class="swap-grid">
        @foreach (var s in swaps)
        {
            <div class="swap-case" data-testid="swap-case-@s">
                <button data-testid="swap-btn-@s" hx-get="/demo/swap/@s" hx-target="#swap-@s">@s</button>
                <div id="swap-@s" data-testid="swap-target-@s" class="swap-out">original</div>
            </div>
        }
    </div>
</section>

<section class="ref-panel">
    <p class="ref-panel__label">Header names</p>
    <p class="ref-panel__note">htmx.NET exposes every htmx response header as a constant on <code>HtmxResponseHeaders.Keys</code>:</p>
    <div class="chips">
        <code>@HtmxResponseHeaders.Keys.Location</code>
        <code>@HtmxResponseHeaders.Keys.PushUrl</code>
        <code>@HtmxResponseHeaders.Keys.Redirect</code>
        <code>@HtmxResponseHeaders.Keys.Refresh</code>
        <code>@HtmxResponseHeaders.Keys.ReplaceUrl</code>
        <code>@HtmxResponseHeaders.Keys.Reswap</code>
        <code>@HtmxResponseHeaders.Keys.Retarget</code>
        <code>@HtmxResponseHeaders.Keys.Reselect</code>
        <code>@HtmxResponseHeaders.Keys.Trigger</code>
    </div>
    <p class="ref-panel__note"><code>Keys.All</code> gives the whole set as an array (handy for CORS):
        <code data-testid="resp-keys">@string.Join(", ", HtmxResponseHeaders.Keys.All)</code></p>
</section>
