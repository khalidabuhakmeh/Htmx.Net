@page
@model Htmx4.Sample.Pages.RequestHeadersModel
@{
    ViewData["Title"] = "RequestHeaders";

    var without = @"// Without htmx.NET: parse the raw headers
var isHtmx = Request.Headers[""HX-Request""] == ""true"";
// HX-Source arrives as ""button#rh-btn-id"" — split it:
var source = Request.Headers[""HX-Source""].ToString();
var hash   = source.IndexOf('#');
var tag    = hash < 0 ? source : source[..hash];
var id     = hash < 0 ? null   : source[(hash + 1)..];";

    var with = @"// With htmx.NET: one call, typed values
if (Request.IsHtmx(out var h))
{
    var tag  = h.SourceElement?.TagName;  // button
    var id   = h.SourceElement?.Id;       // rh-btn-id
    var kind = h.RequestType;             // Full/Partial
}";
}
<h1>Request headers</h1>
<p class="demo-lead">
    htmx adds headers such as <code>HX-Request</code>, <code>HX-Source</code>, <code>HX-Target</code> and
    <code>HX-Request-Type</code> to every request. On the server, <code>Request.IsHtmx(out var h)</code> exposes them as a
    typed <code>HtmxRequestHeaders</code>, including parsed element references (tag name and id). Each button below
    sends a request and the server echoes back what it saw.
</p>

<section class="how">
    <h2>How it works</h2>
    <p>
        <code>HX-Source</code> and <code>HX-Target</code> are sent as <code>tag#id</code> (or just the tag when there is no id).
        The library parses them into an element reference so you don't split strings yourself.
    </p>
    <div class="code-pair">
        <figure class="code code--without">
            <figcaption><span class="file">Without htmx.NET</span><span class="lang">csharp</span></figcaption>
            <pre><code>@without</code></pre>
        </figure>
        <figure class="code code--with">
            <figcaption><span class="file">With htmx.NET</span><span class="lang">csharp</span></figcaption>
            <pre><code>@with</code></pre>
        </figure>
    </div>
</section>

<section class="stage">
    <p class="stage__label">Try it</p>

    <h2>Source with id (HX-Source = <code>button#rh-btn-id</code>, HX-Target = <code>div#rh-result</code>)</h2>
    <div class="btn-row">
        <button id="rh-btn-id" data-testid="rh-btn-id" hx-get="/demo/request-headers?p=rh" hx-target="#rh-result">GET with id</button>
    </div>
    <div class="result" id="rh-result" data-testid="rh-result">(no result yet)</div>

    <h2>Source without id (HX-Source = <code>button</code>, HX-Target = <code>div</code> with no id)</h2>
    <div class="btn-row">
        <button data-testid="rh-btn-noid" hx-get="/demo/request-headers?p=rh2" hx-target="next div">GET without id</button>
    </div>
    <div class="result" data-testid="rh-noid-result">(no result yet)</div>

    <h2>Full request (hx-select makes HX-Request-Type: full)</h2>
    <div class="btn-row">
        <button id="rh-btn-full" data-testid="rh-btn-full" hx-get="/demo/request-headers?p=rh3" hx-select="#rh3-fragment" hx-target="#rh-full-result">GET with hx-select</button>
    </div>
    <p class="hint">
        Click each button and read the <strong>Result</strong> well beneath it: compare the source and target values when the
        element has an <strong>id</strong> versus when it does not, and see the request type flip to
        <strong>full</strong> when <strong>hx-select</strong> is present. Open devtools Network to see the raw headers.
    </p>
    <div class="result" id="rh-full-result" data-testid="rh-full-result">(no result yet)</div>
</section>

<section class="ref-panel">
    <p class="ref-panel__label">Header names</p>
    <p class="ref-panel__note">htmx.NET exposes every htmx request header as a constant on <code>HtmxRequestHeaders.Keys</code>:</p>
    <div class="chips">
        <code data-testid="rh-key-request">@HtmxRequestHeaders.Keys.Request</code>
        <code data-testid="rh-key-request-type">@HtmxRequestHeaders.Keys.RequestType</code>
        <code>@HtmxRequestHeaders.Keys.CurrentUrl</code>
        <code>@HtmxRequestHeaders.Keys.Source</code>
        <code>@HtmxRequestHeaders.Keys.Target</code>
        <code>@HtmxRequestHeaders.Keys.Boosted</code>
        <code>@HtmxRequestHeaders.Keys.HistoryRestoreRequest</code>
        <code>@HtmxRequestHeaders.Keys.Prompt</code>
    </div>
    <p class="ref-panel__note"><code>Keys.All</code> gives the whole set as an array (handy for CORS):
        <code id="rh-keys" data-testid="rh-keys">@string.Join(", ", HtmxRequestHeaders.Keys.All)</code></p>
    <p class="ref-panel__note">This request was a full page load, not htmx:
        <code data-testid="rh-page-is-htmx">@Request.IsHtmx()</code></p>
</section>
