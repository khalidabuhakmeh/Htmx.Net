@page
@model Htmx4.Sample.Pages.ConfigModel
@{
    ViewData["Title"] = "Config";
    var keys = new[] { "logAll", "prefix", "metaCharacter", "transitions", "history", "mode", "defaultSwap", "allowEmptySwapAfterOOB",
        "defaultFocusScroll", "defaultSettleDelay", "indicatorClass", "requestClass", "includeIndicatorCSS", "defaultTimeout",
        "extensions", "morphIgnore", "morphSkip", "morphSkipChildren", "morphScanLimit", "noSwap", "implicitInheritance", "inlineScriptNonce" };

    var markup = @"@section HtmxConfig {
    <meta name=""htmx-config""
          defaultSwap=""beforeend""
          defaultTimeout=""45000""
          mode=""same-origin""
          noSwap=""@(new object[] { 204, 304, 422 })""
          morphIgnore=""@(new[] { ""data-htmx-powered"", ""data-keep"" })""
          implicitInheritance=""false"" />
}";

    var effects = @"<!-- no hx-swap: defaultSwap=beforeend appends -->
<button hx-get=""/demo/config/swap"" hx-target=""#cfg-list"">Add item</button>
<ul id=""cfg-list""><li>initial</li></ul>

<!-- 422 is in noSwap, so the response is not swapped -->
<button hx-get=""/demo/status/422"" hx-target=""#cfg-noswap-target"">GET 422</button>";
}
@section HtmxConfig {
    @* Page-scoped config: replaces the layout's global htmx-config meta on this page only. *@
    <meta name="htmx-config" includeAspNetAntiforgeryToken="true"
          logAll="false" prefix="data-hx-" metaCharacter=":" transitions="true" history="true" mode="same-origin"
          defaultSwap="beforeend" allowEmptySwapAfterOOB="true" defaultFocusScroll="true" defaultSettleDelay="5"
          indicatorClass="loading-dot" requestClass="is-loading" includeIndicatorCSS="true" defaultTimeout="45000"
          extensions="" morphIgnore="@(new[] { "data-htmx-powered", "data-keep" })" morphSkip="[data-skip]"
          morphSkipChildren="[data-skip-children]" morphScanLimit="7" noSwap="@(new object[] { 204, 304, 422 })"
          implicitInheritance="false" inlineScriptNonce="demo-nonce" />
}
<h1>Config</h1>
<p class="demo-lead">
    htmx is configured through a <code>&lt;meta name="htmx-config"&gt;</code> tag. The config tag helper renders it with
    typed attributes, scoped to this page through the <code>HtmxConfig</code> layout section (it replaces the global meta
    from <code>_Layout</code>). The table reads the live <code>htmx.config</code> back so you can see what the browser received.
    The tag helper types <code>history</code> as a string, so <code>history="true"</code> reads back as <code>"true"</code>.
</p>

<section class="how">
    <h2>How it works</h2>
    <p>
        Each attribute on the meta tag maps to an <code>htmx.config</code> key. Array and object values such as
        <code>morphIgnore</code> and <code>noSwap</code> are serialized to JSON. The page then reads
        <code>htmx.config</code> in a script to fill in the table.
    </p>
    <div class="code-pair">
        <figure class="code">
            <figcaption><span class="file">Config.cshtml</span><span class="lang">html</span></figcaption>
            <pre><code>@markup</code></pre>
        </figure>
        <figure class="code">
            <figcaption><span class="file">Config.cshtml</span><span class="lang">html</span></figcaption>
            <pre><code>@effects</code></pre>
        </figure>
    </div>
</section>

<section class="stage">
<p class="stage__label">Try it</p>
<p>Raw meta content:</p>
<pre class="meta-raw"><code data-testid="cfg-meta-raw" id="cfg-meta-raw"></code></pre>
<table>
    <thead><tr><th>key</th><th>htmx.config value (JSON)</th></tr></thead>
    <tbody id="cfg-rows">
    @foreach (var k in keys)
    {
        <tr><td>@k</td><td><code data-testid="cfg-@k" data-key="@k">(pending)</code></td></tr>
    }
    </tbody>
</table>
<p>antiForgery header name: <code data-testid="cfg-antiForgery-header" id="cfg-af-header"></code>; token present: <code data-testid="cfg-antiForgery-token-present" id="cfg-af-token"></code></p>

<h2>Effects</h2>
<p>defaultSwap=beforeend: this button has no hx-swap, so the response is appended.</p>
<div class="btn-row">
    <button data-testid="cfg-btn-swap" hx-get="/demo/config/swap" hx-target="#cfg-list">Add item (default swap)</button>
</div>
<ul id="cfg-list" data-testid="cfg-list"><li data-testid="cfg-list-initial">initial</li></ul>
<p>noSwap includes 422: this error response does NOT swap.</p>
<div class="btn-row">
    <button data-testid="cfg-btn-noswap" hx-get="/demo/status/422" hx-target="#cfg-noswap-target">GET 422</button>
</div>
<p class="hint">
    Click <strong>Add item</strong> repeatedly and watch the list <strong>grow</strong> instead of being replaced. The configured default swap is beforeend. Then click <strong>GET 422</strong>. The box stays
    <strong>untouched</strong> because 422 is listed in noSwap.
</p>
<div class="result" id="cfg-noswap-target" data-testid="cfg-noswap-target">untouched</div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-key]").forEach(function (el) {
                el.textContent = JSON.stringify(htmx.config[el.getAttribute("data-key")]);
            });
            document.getElementById("cfg-meta-raw").textContent = document.querySelector("meta[name=htmx-config]").getAttribute("content").replace(/"requestToken":"[^"]*"/, '"requestToken":"..."');
            const af = htmx.config.antiForgery || {};
            document.getElementById("cfg-af-header").textContent = af.headerName || "";
            document.getElementById("cfg-af-token").textContent = String(!!af.requestToken);
        });
    </script>
}
