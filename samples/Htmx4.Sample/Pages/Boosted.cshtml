@page
@model Htmx4.Sample.Pages.BoostedModel
@{
    ViewData["Title"] = "Boosted";

    var markup = @"<nav hx-boost:inherited=""true"">
    <a href=""/BoostedOther"">Go to BoostedOther (boosted)</a>
    <a href=""/Boosted"" hx-boost=""false"">Unboosted link</a>
</nav>

<form method=""post"" hx-boost=""true"" action=""/Boosted?handler=Post"">
    <input name=""note"" value=""boosted-form"" />
    <button type=""submit"">Boosted POST form</button>
</form>";

    var server = @"// Boosted.cshtml (Razor view)
boosted = @Request.IsHtmxBoosted()
htmx    = @Request.IsHtmx()
plain   = @Request.IsHtmxNonBoosted()";
}

<h1>Boosted</h1>
<p class="demo-lead">
    <code>hx-boost</code> turns ordinary links and forms into AJAX requests that swap the page body,
    with no full reload. The server detects a boosted request with <code>Request.IsHtmxBoosted()</code>.
</p>

<section class="stage">
    <p class="stage__label">Try it</p>
    <nav hx-boost:inherited="true" data-testid="boost-container" class="btn-row">
        <a href="/BoostedOther" data-testid="boost-link-other">Go to BoostedOther (boosted)</a>
        <a href="/Boosted" data-testid="boost-link-self">Reload Boosted (boosted)</a>
        <a href="/Boosted" hx-boost="false" data-testid="boost-link-unboosted">Unboosted link</a>
    </nav>
    <form method="post" hx-boost="true" action="/Boosted?handler=Post" data-testid="boost-form" class="btn-row">
        <input name="note" value="boosted-form" />
        <button type="submit" data-testid="boost-form-submit">Boosted POST form</button>
    </form>
    <p class="hint">
        Click a <strong>boosted</strong> link and watch the line below: <strong>boosted</strong> flips to true and the
        page swaps without a full reload. The <strong>unboosted</strong> link does a normal navigation, so boosted stays false.
    </p>
    <div class="result">
        <p>Server saw this request as: boosted=<code data-testid="boost-is-boosted">@Request.IsHtmxBoosted()</code>,
            htmx=<code data-testid="boost-is-htmx">@Request.IsHtmx()</code>, non-boosted=<code data-testid="boost-is-nonboosted">@Request.IsHtmxNonBoosted()</code>,
            request type=<code data-testid="boost-request-type">@Model.RequestType</code>, page=<code data-testid="boost-page">boosted</code></p>
        <p>Last POST: <code data-testid="boost-post-result">@Model.PostResult</code></p>
    </div>
</section>

<section class="how">
    <h2>How it works</h2>
    <p>
        Put <code>hx-boost:inherited="true"</code> on a container and every link inside is boosted; opt a single link out with
        <code>hx-boost="false"</code>. Boosted requests carry the <code>HX-Boosted</code> header, which the server reads.
    </p>
    <figure class="code">
        <figcaption><span class="file">Boosted.cshtml</span><span class="lang">html</span></figcaption>
        <pre><code>@markup</code></pre>
    </figure>
    <figure class="code">
        <figcaption><span class="file">Boosted.cshtml</span><span class="lang">csharp</span></figcaption>
        <pre><code>@server</code></pre>
    </figure>
</section>
