@using Htmx.TagHelpers
@{
    // Add D2 demo pages here; Index and the nav both read this list.
    var demos = Htmx4.Sample.Demos.All;
    var path = Context.Request.Path.Value?.Trim('/') ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - htmx.NET × htmx 4</title>
    @if (IsSectionDefined("HtmxConfig"))
    {
        @* Page-scoped config: a page replaces the global meta (only one htmx-config meta may exist). *@
        @await RenderSectionAsync("HtmxConfig")
    }
    else
    {
        <meta name="htmx-config" includeAspNetAntiforgeryToken="true" indicatorClass="htmx-indicator" />
    }
    @* Inter (body) + JetBrains Mono (code) to match the htmx 4 site; ChicagoFLF (display) is vendored in site.css. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/lib/highlight/github.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!--
        Vendored htmx 4.0.0 (https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js)
        sha256: e484d9171a9db30a39c8f16e3d709d4137f3211c659f8e6125816635033d593f
        SRI: sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc
    -->
    <script src="~/lib/htmx/htmx.min.js" defer integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc"></script>
    <script src="@HtmxAntiforgeryScriptEndpoints.Path" defer></script>
    <script src="~/lib/highlight/highlight.min.js" defer></script>
    <script src="~/js/demo.js" defer></script>
</head>
<body>
<header class="site-header">
    <div class="site-header__bar">
        <a class="brand" href="/">htm<span class="x">x</span>.net<small>htmx 4</small></a>
        <nav class="demo-nav" aria-label="Demos">
            <a href="/"@(path == "" ? " aria-current=\"page\"" : "")>Home</a>
            @foreach (var d in demos)
            {
                <a href="/@d" data-testid="nav-@d"@(string.Equals(path, d, StringComparison.OrdinalIgnoreCase) ? " aria-current=\"page\"" : "")>@d</a>
            }
        </nav>
    </div>
</header>
<main id="main" data-testid="main">
    @RenderBody()
</main>
<footer class="site-footer">
    Built with <a href="https://github.com/khalidabuhakmeh/Htmx.Net">htmx.NET</a> and
    <a href="https://four.htmx.org/">htmx 4</a>. Every page here is backed by integration and Playwright E2E tests.
</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
