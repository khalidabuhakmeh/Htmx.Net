<Project>
    <PropertyGroup>
        <!-- Properties that apply to all projects in the solution root -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <VersionPrefix>2.0.0</VersionPrefix>
        <VersionSuffix>preview</VersionSuffix>
        <!-- MinVer drives the actual package version from git tags; these pin the major and pre-release phase -->
        <MinVerMinimumMajorMinor>2.0</MinVerMinimumMajorMinor>
        <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>

        <!-- Symbols packages -->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>