<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <PackageId>Htmx.TagHelpers</PackageId>
        <Authors>Khalid Abuhakmeh</Authors>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/khalidabuhakmeh/Htmx.Net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>htmx;htmx4;aspnetcore;dotnet;razor;mvc;razor-pages;taghelpers;web</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>2.0.0 targets htmx 4 and is a breaking change from the 1.x line. See the migration guide: https://khalidabuhakmeh.github.io/Htmx.Net/migration/v1-to-v2/ and CHANGELOG.md.</PackageReleaseNotes>
        <Description>
            ASP.NET Core tag helpers for htmx 4: generate URLs from routing onto htmx attributes, write a typed htmx-config meta tag, and wire up antiforgery. Mimics the built-in ASP.NET Core URL tag helpers.
        </Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Remove="antiforgerySnippet.js" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
        <None Include="..\..\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="JavaScript\antiforgerySnippet.js" LogicalName="AntiforgeryJavaScript" />
        <EmbeddedResource Include="JavaScript\antiforgerySnippet.min.js" LogicalName="AntiforgeryJavaScriptMinified" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\..\shared\JetBrains.Annotations.cs">
        <Link>JetBrains.Annotations.cs</Link>
      </Compile>
      <Compile Include="..\..\shared\Shared.cs">
        <Link>Shared.cs</Link>
      </Compile>
    </ItemGroup>

    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <PropertyGroup>
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0037</WarningsAsErrors>
    </PropertyGroup>

</Project>